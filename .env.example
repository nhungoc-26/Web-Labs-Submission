# Environment variable template — KHÔNG chứa secret thật.
# Copy thành .env trong đúng thư mục project cần dùng rồi điền giá trị.
# File .env đã nằm trong .gitignore, không bao giờ được commit.

# ---------------------------------------------------------------
# lab4/homework/hw2/server  (Express + Mongoose 8)
# ---------------------------------------------------------------
# Bắt buộc. Server sẽ throw Error('MONGODB_URI missing') nếu thiếu.
# Local:  mongodb://127.0.0.1:27017/hen-ho-nhung-khong-yeu
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hen-ho-nhung-khong-yeu
MONGODB_URI=

# Không bắt buộc. Mặc định 5000 (client proxy /api -> http://localhost:5000).
PORT=5000

